<?xml version="1.0" encoding="utf-8"?>
<!-- 集卡片:选中=正在看/刚看,焦点另加描边。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A5F" />
            <stroke android:width="2dp" android:color="@color/focus_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1E3A5F" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <stroke android:width="2dp" android:color="@color/focus_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#161B22" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
